      "spec": {
        "backoffLimit": 3,
        "template": {
          "spec": {
            "automountServiceAccountToken": false,
            "restartPolicy": "OnFailure",
            "containers": [
              {
                "name": "init",
                "image": "redis:7-alpine",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
