{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "smartticket"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "cluster-config",
        "namespace": "smartticket"
      },
      "data": {
        "postgres-init.sh": "#!/bin/sh\nset -eu\npsql -v ON_ERROR_STOP=1 --username \"$POSTGRES_USER\" --dbname postgres \\\n  --set=core_password=\"$CORE_DB_PASSWORD\" --set=knowledge_password=\"$KNOWLEDGE_DB_PASSWORD\" <<'SQL'\nCREATE ROLE core LOGIN PASSWORD :'core_password';\nCREATE ROLE knowledge LOGIN PASSWORD :'knowledge_password';\nCREATE DATABASE intelligent_ticket OWNER core;\nCREATE DATABASE smartticket_knowledge OWNER knowledge;\nREVOKE CONNECT ON DATABASE intelligent_ticket FROM PUBLIC;\nREVOKE CONNECT ON DATABASE smartticket_knowledge FROM PUBLIC;\nGRANT CONNECT ON DATABASE intelligent_ticket TO core;\nGRANT CONNECT ON DATABASE smartticket_knowledge TO knowledge;\nSQL\npsql -v ON_ERROR_STOP=1 --username \"$POSTGRES_USER\" --dbname intelligent_ticket -c 'CREATE EXTENSION IF NOT EXISTS vector;'\n",
        "redis-start.sh": "#!/bin/sh\nset -eu\nnode_ip=$(hostname -i | awk '{print $1}')\nexec redis-server --appendonly yes --cluster-enabled yes --cluster-config-file /data/nodes.conf \\\n  --cluster-node-timeout 5000 --cluster-announce-ip \"$node_ip\" --cluster-announce-hostname \"$NODE_NAME\" \\\n  --cluster-preferred-endpoint-type hostname --requirepass \"$REDIS_PASSWORD\" \\\n  --masterauth \"$REDIS_PASSWORD\" --maxmemory 96mb --maxmemory-policy noeviction\n",
        "redis-init.sh": "#!/bin/sh\nset -eu\nexport REDISCLI_AUTH=\"$REDIS_PASSWORD\"\nhosts=\"\"\nfor i in 0 1 2 3 4 5; do\n  host=\"redis-$i${REDIS_DNS_SUFFIX:-}\"\n  until redis-cli -h \"$host\" ping | grep -q PONG; do sleep 2; done\n  hosts=\"$hosts $host:6379\"\ndone\nfirst=\"redis-0${REDIS_DNS_SUFFIX:-}\"\nif redis-cli -h \"$first\" cluster info | grep -q 'cluster_slots_assigned:0'; then\n  # Only create a fresh isolated node. Never reset a partially initialized cluster.\n  if ! redis-cli -h \"$first\" cluster info | grep -q 'cluster_known_nodes:1'; then\n    echo 'Existing incomplete cluster requires operator inspection; refusing to reset data.' >&2\n    exit 1\n  fi\n  redis-cli --cluster create $hosts --cluster-replicas 1 --cluster-yes\nelse\n  # Persisted nodes.conf contains old IPs after containers/Pods are recreated.\n  # MEET refreshes peer addresses without deleting keys, IDs, roles or slot ownership.\n  for i in 1 2 3 4 5; do\n    host=\"redis-$i${REDIS_DNS_SUFFIX:-}\"\n    peer_ip=$(getent hosts \"$host\" | awk 'NR==1 {print $1}')\n    test -n \"$peer_ip\"\n    redis-cli -h \"$first\" cluster meet \"$peer_ip\" 6379\n  done\nfi\n\nfor attempt in $(seq 1 90); do\n  ready=true\n  topology=\"\"\n  for address in $hosts; do\n    host=${address%:6379}\n    if ! redis-cli -h \"$host\" cluster info | grep -q 'cluster_state:ok'; then ready=false; fi\n    replication=$(redis-cli -h \"$host\" info replication)\n    if printf '%s' \"$replication\" | grep -q '^role:slave'; then\n      if ! printf '%s' \"$replication\" | grep -q '^master_link_status:up'; then ready=false; fi\n    elif ! printf '%s' \"$replication\" | grep -Eq '^connected_slaves:[1-9]'; then ready=false\n    fi\n    # A connected replica is not enough: every node must agree on each primary's\n    # epoch and slots before an automatic election can safely obtain votes.\n    view=$(redis-cli -h \"$host\" cluster nodes | awk '$3 ~ /master/ {printf \"%s %s \",$1,$7; for(i=9;i<=NF;i++)printf \"%s \",$i; print \"\"}' | sort)\n    if [ -z \"$topology\" ]; then topology=$view\n    elif [ \"$topology\" != \"$view\" ]; then ready=false\n    fi\n  done\n  if [ \"$ready\" = true ]; then echo 'Redis slots and every replication link are ready'; exit 0; fi\n  sleep 2\ndone\necho 'Existing cluster did not recover; data and topology were preserved for inspection.' >&2\nexit 1\n",
        "default.conf": "server {\n    listen 80;\n    root /usr/share/nginx/html;\n    server_tokens off;\n    client_max_body_size 1m;\n    add_header X-Content-Type-Options nosniff always;\n    add_header X-Frame-Options DENY always;\n    location = /health { return 200 'ok'; }\n    location /api/ {\n        proxy_pass http://gateway:8080;\n        proxy_set_header Host $host;\n        proxy_set_header X-Forwarded-For $remote_addr;\n        proxy_set_header X-Forwarded-Proto $scheme;\n        proxy_read_timeout 180s;\n    }\n    location / { try_files $uri $uri/ /index.html; }\n}\n",
        "rabbitmq.conf": "listeners.tcp.default = 5672\ncluster_formation.peer_discovery_backend = classic_config\ncluster_formation.classic_config.nodes.1 = rabbit@rabbit-0.rabbit-nodes.smartticket.svc.cluster.local\ncluster_formation.classic_config.nodes.2 = rabbit@rabbit-1.rabbit-nodes.smartticket.svc.cluster.local\ncluster_formation.classic_config.nodes.3 = rabbit@rabbit-2.rabbit-nodes.smartticket.svc.cluster.local\ncluster_partition_handling = pause_minority\nqueue_leader_locator = balanced\nvm_memory_high_watermark.absolute = 256MiB\ndisk_free_limit.absolute = 128MB\nquorum_queue.continuous_membership_reconciliation.enabled = true\nquorum_queue.continuous_membership_reconciliation.target_group_size = 3\nquorum_queue.continuous_membership_reconciliation.interval = 10000\nquorum_queue.continuous_membership_reconciliation.auto_remove = false\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "smartticket"
      },
      "spec": {
        "selector": {
          "app": "postgres"
        },
        "ports": [
          {
            "name": "postgres",
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "postgres",
        "namespace": "smartticket"
      },
      "spec": {
        "serviceName": "postgres",
        "replicas": 1,
        "podManagementPolicy": "Parallel",
        "selector": {
          "matchLabels": {
            "app": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "postgres",
                "image": "pgvector/pgvector:pg18",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                },
                "env": [
                  {
                    "name": "POSTGRES_USER",
                    "value": "cluster_admin"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cluster-secrets",
                        "key": "POSTGRES_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "CORE_DB_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cluster-secrets",
                        "key": "CORE_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "KNOWLEDGE_DB_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cluster-secrets",
                        "key": "KNOWLEDGE_DB_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-ec",
                      "pg_isready -U cluster_admin -d postgres"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 12
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql"
                  },
                  {
                    "name": "config",
                    "mountPath": "/docker-entrypoint-initdb.d/init.sh",
                    "subPath": "postgres-init.sh",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "cluster-config",
                  "defaultMode": 365
                }
              }
            ],
            "terminationGracePeriodSeconds": 40
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "1Gi"
                }
              }
            }
          }
        ]
      }
    },
