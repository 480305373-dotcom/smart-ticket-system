                "readinessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 8080
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 8080
                  },
                  "periodSeconds": 15,
                  "failureThreshold": 5,
                  "timeoutSeconds": 3
                },
