                  },
                  {
                    "name": "SPRING_DATA_REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cluster-secrets",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  },
