            "terminationGracePeriodSeconds": 60,
            "containers": [
              {
                "name": "backend",
                "image": "smartticket/backend:local",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "768Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
