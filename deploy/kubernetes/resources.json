                },
                "env": [
                  {
                    "name": "REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cluster-secrets",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "REDIS_DNS_SUFFIX",
                    "value": ".redis-nodes"
                  }
                ],
                "command": [
                  "sh",
                  "/opt/redis-init.sh"
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/opt/redis-init.sh",
                    "subPath": "redis-init.sh",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "cluster-config"
                }
              }
            ]
          }
        }
      }
    },
