                    "containerPort": 5672
                  },
                  {
                    "containerPort": 4369
                  },
                  {
                    "containerPort": 25672
                  },
                  {
                    "containerPort": 15672
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-ec",
                      "rabbitmq-diagnostics -q ping"
                    ]
