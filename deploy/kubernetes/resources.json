                "labelSelector": {
                  "matchLabels": {
                    "app": "backend"
                  }
                }
              }
            ],
            "initContainers": [
              {
                "name": "wait-infrastructure",
                "image": "redis:7-alpine",
                "imagePullPolicy": "IfNotPresent",
