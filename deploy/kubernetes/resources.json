                    "value": "-Duser.timezone=Asia/Shanghai -XX:ActiveProcessorCount=2"
                  },
                  {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "enterprise,ai,distributed"
                  },
                  {
                    "name": "SERVER_ADDRESS",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "SPRING_DATASOURCE_URL",
