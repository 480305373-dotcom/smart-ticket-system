      "kind": "StatefulSet",
      "metadata": {
        "name": "rabbit",
        "namespace": "smartticket"
      },
      "spec": {
        "serviceName": "rabbit-nodes",
        "replicas": 3,
        "podManagementPolicy": "Parallel",
        "selector": {
          "matchLabels": {
            "app": "rabbit"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "rabbit"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "rabbit",
                "image": "rabbitmq:4-management",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
