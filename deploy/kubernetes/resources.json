                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 12
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-ec",
                      "rabbitmq-diagnostics -q ping"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 3,
                  "failureThreshold": 60
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/rabbitmq"
                  },
                  {
                    "name": "config",
                    "mountPath": "/etc/rabbitmq/rabbitmq.conf",
                    "subPath": "rabbitmq.conf",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "cluster-config",
                  "defaultMode": 365
                }
              }
            ],
            "terminationGracePeriodSeconds": 40,
            "topologySpreadConstraints": [
              {
                "maxSkew": 1,
                "topologyKey": "kubernetes.io/hostname",
                "whenUnsatisfiable": "ScheduleAnyway",
                "labelSelector": {
                  "matchLabels": {
                    "app": "rabbit"
                  }
                }
              }
            ],
            "affinity": {
              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "app": "rabbit"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            }
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "1Gi"
                }
              }
            }
          }
        ]
      }
    },
