                    "name": "RABBITMQ_ADDRESSES",
                    "value": "rabbit-0.rabbit-nodes:5672,rabbit-1.rabbit-nodes:5672,rabbit-2.rabbit-nodes:5672"
                  },
                  {
                    "name": "SPRING_RABBITMQ_USERNAME",
                    "value": "smartticket"
                  },
                  {
                    "name": "SPRING_RABBITMQ_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cluster-secrets",
                        "key": "RABBITMQ_PASSWORD"
                      }
