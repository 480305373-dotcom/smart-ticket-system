{
  "kind": "Cluster",
  "apiVersion": "kind.x-k8s.io/v1alpha4",
  "name": "smartticket",
  "nodes": [
    {
      "role": "control-plane",
      "kubeadmConfigPatches": [
        "kind: InitConfiguration\nnodeRegistration:\n  taints: []\n"
      ],
      "extraPortMappings": [
        {
          "containerPort": 30090,
          "hostPort": 8091,
          "listenAddress": "127.0.0.1"
        }
      ]
    },
    {
      "role": "worker"
    },
    {
      "role": "worker"
    }
  ]
}
