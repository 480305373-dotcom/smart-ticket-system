                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "cluster-secrets",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  }
                ],
                "command": [
                  "sh",
                  "-ec",
                  "until wget -q --spider http://knowledge:8080/actuator/health/readiness; do sleep 3; done; until nc -z rabbit-ready 5672; do sleep 3; done; until REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli -h redis-0.redis-nodes cluster info | grep -q cluster_state:ok; do sleep 3; done"
                ]
              }
            ]
          }
        }
